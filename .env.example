# ── IQ Option Auto-Trading ────────────────────────────────────────────────────
# IQ_DEMO=false switches to your real-money account (use with caution!)
IQ_EMAIL=your_iqoption_email@example.com
IQ_PASSWORD=your_iqoption_password
IQ_DEMO=true

# ALLOW_OTC=true trades IQ's synthetic OTC feed when the real market is closed
# (the strategy reads real-market prices, so signals don't apply there).
ALLOW_OTC=false
# Skip placements when IQ's turbo payout is below this fraction.
MIN_PAYOUT=0.75

# Used for the stake (2%) only until the live IQ balance is known.
ACCOUNT_BALANCE=50000

# ── Web app (PWA) at https://bot.collxct.ng ──────────────────────────────────
DASHBOARD_PASSWORD=choose_a_long_password
# Any long random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=replace_with_random_hex
# Optional: starting balance for the Net P&L tile (default: first recorded balance)
START_BALANCE=

# ── Web push (generate once: python -m notifications.push --gen-keys) ─────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Email (optional — push notifications replace it) ─────────────────────────
EMAIL_ENABLED=false
EMAIL_SENDER=alerts@example.com
EMAIL_PASSWORD=your_smtp_password
EMAIL_RECIPIENT=you@example.com
SMTP_HOST=smtp.hmailplus.com
SMTP_PORT=587

# ── Price feed fallback (optional) ────────────────────────────────────────────
# Deriv's public feed is primary; Twelve Data is used only if it fails.
TWELVEDATA_API_KEY=

# ── One-time history import only (python import_history.py) ──────────────────
# The secret Gist is read by its raw URL — no token needed.
TRADE_LOG_GIST_ID=
